# Used by scripts/etl/build.mjs to sync from Google Sheets. Not read by the
# Next.js app itself — the app only ever reads the static public/data/*.json
# this script produces, so these never reach the browser bundle.

# One of the two below (JSON content takes priority if both are set):

# The service account key file's full JSON contents, on one line — the way
# you'd store it as a GitHub Actions secret.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ...or a path to the key file, for local development.
# GOOGLE_SERVICE_ACCOUNT_KEY_PATH=/path/to/service-account-key.json

# The Google Sheet ID (from its URL, between /d/ and /edit).
# PINJAL_SHEET_ID=1tjZL_VkerOPZDk4bcgIRDubRWY8IqNaLUFIP264yS7E
